{
    "name": "honeyent",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "build": "npm run build:all",
        "start": "node start.js",
        "postinstall": "npm --prefix backend install && npm --prefix frontend install",
        "install:all": "npm --prefix backend install && npm --prefix frontend install",
        "build:backend": "npm --prefix backend run build",
        "start:backend": "npm --prefix backend start",
        "build:frontend": "npm --prefix frontend run build",
        "start:frontend": "npm --prefix frontend start",
        "build:all": "npm --prefix backend run build && npm --prefix frontend run build",
        "start:all": "node start.js",
        "dev:backend": "npm --prefix backend run dev",
        "dev:frontend": "npm --prefix frontend run dev"
    }
}