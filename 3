-- termsdb.customer_master source

CREATE OR REPLACE VIEW termsdb.customer_master_main
AS SELECT b.unit_code,
    c.city_code,
    a.vendor_code AS code,
    c.vendor_address_type AS plant_code,
    a.name,
    a.cust_type,
    a.industry_category AS industry_segment,
    concat(c.address1, ' ', c.address2, ' ', c.address3) AS address,
    a.industry_type,
    a.industry_category,
    a.registered_dealer,
    'Y'::text AS is_existing,
    c.pin_code AS pin,
    c.phones AS telephone,
    c.fax,
    c.telex AS email,
    c.telex AS vmail,
    a.norms AS transit_period,
    a.cst_num AS cst,
    a.cst_date,
    a.lst_num AS lst,
    a.lst_date,
    a.name AS short_name,
    a.range,
    a.division,
    a.ecc_number,
    a.registeration_date AS cust_join_dt,
    NULL::text AS centre_code,
    a.stax_type AS sale_tax_type,
    NULL::text AS cust_side_vend_code,
    NULL::text AS zone,
    NULL::text AS cust_sub_code,
    a.name AS short_code,
    a.norms AS credit_period,
    NULL::text AS centre_code_owner,
    a.inter_unit AS flag_interunit,
    a.amt_limit,
    a.pay_term AS agreed_term,
    a.pan_no,
    c.contact_person AS contact,
    NULL::text AS title,
    NULL::text AS department,
    c.phones AS mobile_no,
    a.auto_code AS ref_by,
    NULL::text AS web_site,
    a.tin,
    NULL::text AS market_type,
    a.tcs_per,
    a.over_limit,
    COALESCE(a.gl_cd, NULL::text) AS gl_cd,
    a.packing_per,
    NULL::text AS interest_rate,
    a.approved_by AS app_by,
    a.registeration_date AS app_date,
    a.inter_unit,
    'A'::text AS cust_status,
    c.city AS city_name,
    a.exc_cd,
    c.state_gst_code AS st_code,
    a.sale_tax_type AS st_type,
    a.gst_reg_no,
    a.gst_reg_dt,
    a.gst_code,
    a.gst_rate,
    c.address3 AS del_destination,
        CASE
            WHEN a.vendor_flag = 'I'::text THEN 'DO'::text
            ELSE 'EX'::text
        END AS vendor_flag,
    'N'::text AS asn_appl
   FROM termsdb.vendor_master a,
    termsdb.vend_unit b,
    termsdb.vendor_regd_address c
  WHERE a.vendor_code = c.vendor_code AND a.vendor_code = b.ven_cd AND (a.party_type = ANY (ARRAY['B'::text, 'C'::text])) AND a.vendor_status <> 'BL'::text;

-- Permissions

ALTER TABLE termsdb.customer_master OWNER TO postgres;
GRANT ALL ON TABLE termsdb.customer_master TO postgres;