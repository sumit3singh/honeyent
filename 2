-- termsdb.customer source

CREATE OR REPLACE VIEW termsdb.customer
AS SELECT b.unit_code,
    v.city_code,
    a.vendor_code AS code,
    v.vendor_address_type AS plant_code,
    a.name,
    a.cust_type,
    a.industry_category AS industry_segment,
    concat(v.address1, ' ', v.address2, ' ', v.address3) AS address,
    a.industry_type,
    a.industry_category,
    a.registered_dealer,
    'Y'::text AS is_existing,
    v.pin_code AS pin,
    v.phones AS telephone,
    v.fax,
    v.telex AS email,
    v.telex AS vmail,
    a.norms AS transit_period,
    a.cst_num AS cst,
    a.cst_date,
    a.lst_num AS lst,
    a.lst_date,
    a.name AS short_name,
    a.range,
    a.division,
    a.ecc_number,
    a.registeration_date AS cust_join_dt,
    NULL::text AS centre_code,
    a.stax_type AS sale_tax_type,
    NULL::text AS cust_side_vend_code,
    ' '::text AS zone,
    NULL::text AS cust_sub_code,
    a.name AS short_code,
    a.norms AS credit_period,
    NULL::text AS centre_code_owner,
    a.inter_unit AS flag_interunit,
    a.amt_limit,
    a.pay_term AS agreed_term,
    a.pan_no,
    v.contact_person AS contact,
    NULL::text AS title,
    NULL::text AS department,
    v.phones AS mobile_no,
    a.auto_code AS ref_by,
    NULL::text AS web_site,
    a.tin,
    NULL::text AS market_type,
    a.tcs_per,
    a.over_limit,
    COALESCE(b.gl_cd, a.gl_cd) AS gl_cd,
    a.packing_per,
    NULL::text AS interest_rate,
    a.approved_by AS app_by,
    a.registeration_date AS app_date,
    a.inter_unit,
    'A'::text AS cust_status,
    v.city AS city_name,
    a.gst_reg_no,
    a.gst_reg_dt,
    a.gst_code,
    a.gst_rate,
    b.party_tp,
    v.state_code,
    a.cust_cons_type,
    a.sale_tax_type AS sale_tax_type1,
    a.referral_code,
    a.curr_code,
    a.vendor_type,
    a.tcs_code,
    v.ven_add_code,
    a.name::character varying AS sh_name,
    b.vendor_code AS vend_code,
    (v.state_gst_code || ' '::text) || v.state AS state
   FROM termsdb.vendor_master a,
    termsdb.vend_unit b,
    termsdb.vendor_regd_address c,
    termsdb.vend_add_new v
  WHERE a.vendor_code = c.vendor_code AND a.vendor_code = v.vendor_code AND a.vendor_code = b.ven_cd AND a.party_type = 'C'::text AND a.approved_by IS NOT NULL AND a.vendor_status <> 'BL'::text;

-- Permissions

ALTER TABLE termsdb.customer OWNER TO postgres;
GRANT ALL ON TABLE termsdb.customer TO postgres;